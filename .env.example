# =============================================================================
# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored - never commit your real credentials.
# =============================================================================

# --- DagsHub (DVC remote + MLflow tracking server) ---------------------------
# DagsHub username (the account that owns or has write access to the repo).
DAGSHUB_USER=your-dagshub-username

# DagsHub access token, generated at https://dagshub.com/user/settings/tokens
# Used as MLflow tracking password and as AWS_SECRET for the DVC S3 remote.
DAGSHUB_TOKEN=your-dagshub-token

# --- Host paths --------------------------------------------------------------
# Absolute path on the host to this project's checkout, used by Airflow's
# DockerOperator to bind-mount the project into dvc-runner / dvc tasks.
# macOS/Linux example below; on Windows use forward slashes (e.g. c:/Users/.../mlops_projects_rakuten).
PROJECT_ROOT_HOST=/absolute/path/to/mlops_projects_rakuten

# --- Service-to-service auth (optional, sensible defaults exist) -------------
# Static bearer token used by the Airflow DAG to call the gateway.
# API_TOKEN=mlops-secret-token

# --- MLflow model selection (optional, sensible defaults exist) --------------
# Override which versions/stages the predict APIs load. Leave unset to use the
# Production stage of each registered model.
# TEXT_MLFLOW_MODEL_NAME=Text_Classifier_SVM
# TEXT_MLFLOW_MODEL_STAGE=Production
# TEXT_MLFLOW_MODEL_VERSION=
# TEXT_MLFLOW_MODEL_ALIAS=
# TEXT_MLFLOW_MODEL_URI=
# TEXT_MLFLOW_VECTORIZER_ARTIFACT_PATH=preprocessing/tfidf.joblib

# IMAGE_MLFLOW_MODEL_NAME=CNN_Image_Classifier
# IMAGE_MLFLOW_MODEL_STAGE=Production
# IMAGE_MLFLOW_MODEL_VERSION=
# IMAGE_MLFLOW_MODEL_ALIAS=
# IMAGE_MLFLOW_MODEL_URI=

# =============================================================================
# Airflow Variables (NOT loaded from .env - set them inside the airflow container)
# After `docker compose up -d`, run:
#
#   docker compose exec -T airflow airflow variables set dagshub_user "<value>"
#   docker compose exec -T airflow airflow variables set dagshub_token "<value>"
#   docker compose exec -T airflow airflow variables set challengedata_username "<value>"
#   docker compose exec -T airflow airflow variables set challengedata_password "<value>"
#   docker compose exec -T airflow airflow variables set git_username "<github-username>"
#   docker compose exec -T airflow airflow variables set git_token "<github-pat-with-repo-scope>"
# =============================================================================
