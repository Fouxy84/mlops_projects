        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(\n  0.95,\n  sum by (le, model_type) (rate(mlops_prediction_duration_seconds_bucket[5m]))\n)", "legendFormat": "{{model_type}}", "refId": "A" }
      ]
    },
    {
